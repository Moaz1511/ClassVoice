# Runtime
APP_ENV=local
APP_BASE_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/v1
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000
REQUEST_ID_HEADER=X-Request-ID

# Authentication profile: `local` is deterministic/in-memory for development and CI;
# `supabase` requires the real values below and is used only by a deployed profile.
CLASSVOICE_AUTH_PROVIDER=local
CLASSVOICE_AUTH_EMAIL_CONFIRMATION=true
CLASSVOICE_AUTH_REDIRECT_ALLOWLIST=http://localhost:3000/auth/callback
CLASSVOICE_AUTH_VERIFICATION_TTL_SECONDS=86400
CLASSVOICE_AUTH_PASSWORD_RESET_TTL_SECONDS=3600
CLASSVOICE_AUTH_SESSION_TTL_SECONDS=3600

# Supabase Auth / Storage (public anon key may be used by the browser)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key
# Server-only. Never expose this to the browser or a Kaggle notebook.
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-key
# Server-only JWT verification secret and issuer. The issuer defaults to
# `${NEXT_PUBLIC_SUPABASE_URL}/auth/v1` when omitted for a real Supabase URL.
SUPABASE_JWT_SECRET=replace-with-jwt-secret
SUPABASE_JWT_ISSUER=
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_CLOCK_SKEW_SECONDS=30

# Database and queue
DATABASE_URL=postgresql+asyncpg://classvoice:change-me@localhost:5432/classvoice
REDIS_URL=redis://localhost:6379/0

# Storage adapter: supabase or s3 (LocalStack provides S3 locally)
STORAGE_PROVIDER=s3
S3_ENDPOINT=http://localhost:4566
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=change-me
S3_BUCKET_VOICE_INPUTS=voice-inputs
S3_BUCKET_VOICE_DERIVED=voice-derived
S3_BUCKET_GENERATED_AUDIO=generated-audio
S3_BUCKET_EXPORTS=exports
STORAGE_SIGNED_URL_TTL_SECONDS=600

# Worker / inference
WORKER_DEVICE=cpu
MODEL_REGISTRY_MANIFEST=infra/model-registry/manifest.json
WORKER_CALLBACK_SECRET=replace-with-short-lived-worker-secret

# Optional operations
SENTRY_DSN=
RESEND_API_KEY=
