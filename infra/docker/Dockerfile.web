FROM node:24.22.1-alpine AS deps

WORKDIR /opt/classvoice
COPY package.json package-lock.json ./
COPY apps/web/package.json apps/web/package.json
COPY packages/api-client/package.json packages/api-client/package.json
COPY packages/contracts/package.json packages/contracts/package.json
COPY packages/ui/package.json packages/ui/package.json
RUN npm ci --workspace @classvoice/web --include-workspace-root=false

FROM node:24.22.1-alpine AS builder

WORKDIR /opt/classvoice
COPY --from=deps /opt/classvoice/node_modules ./node_modules
COPY package.json package-lock.json ./
COPY apps/web ./apps/web
COPY packages ./packages
RUN npm --workspace @classvoice/web run build

FROM node:24.22.1-alpine AS runner

WORKDIR /opt/classvoice
ENV NODE_ENV=production
ENV PORT=3000
COPY --from=builder /opt/classvoice/apps/web/.next/standalone ./
COPY --from=builder /opt/classvoice/apps/web/.next/static ./apps/web/.next/static

EXPOSE 3000

CMD ["node", "apps/web/server.js"]
