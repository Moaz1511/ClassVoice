FROM python:3.13.14-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /opt/classvoice
RUN apt-get update \
    && apt-get install -y --no-install-recommends ffmpeg=7:7.1.5-0+deb13u1 \
    && rm -rf /var/lib/apt/lists/*
COPY apps/api/requirements.txt /opt/classvoice/requirements.txt
RUN pip install --no-cache-dir -r /opt/classvoice/requirements.txt
COPY apps/api/app /opt/classvoice/app
COPY infra/model-registry/manifest.json /opt/classvoice/model-registry/manifest.json
COPY infra/docker/health_server.py /opt/classvoice/health_server.py

EXPOSE 8000 8001

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
